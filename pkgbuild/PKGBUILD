pkgname=lore
pkgver=0.3.2
pkgrel=1
pkgdesc='Project memory, conversation archive, and wiki for Claude Code and Codex'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/lore "$pkgdir/usr/bin/lore"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/lore.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/lore.svg"
  install -Dm644 "$startdir/lore.desktop" "$pkgdir/usr/share/applications/lore.desktop"
}
